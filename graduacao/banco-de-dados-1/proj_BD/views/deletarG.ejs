<%- include("head.ejs") -%>

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Deletar Gato</title>
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: antiquewhite;
        }
        .space {
            display: flex;
            align-items: center;
            flex-direction: column;
            gap: 2em;
        }
        .titulo {
            background-color: rgba(7, 7, 7, 0.781);
            width: 80%;
            padding-top: 3em;
            padding-bottom: 3em;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0em 0em 5em 5em;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            color: azure;
        }
        h1 {
            margin: 0;
            font-weight: 700;
        }
        table th, table td {
            padding: 1em;
            text-align: center;
        }
    </style>
</head>
<body class="container" style="background-color: azure">
    <div class="space">
        <div class="titulo">
            <h1>Deletar Gato</h1>
        </div>
        <form action="/deletarG/<%=dados[0].Cod_Gato%>" method="post" style="width: 100%;">
            <div style="display: flex; flex-direction: column; gap: 1em;">
                <div>
                    <label for="">Código do Gato</label>
                    <input type="number" disabled="" name="Código do Gato" class="form-control" value="<%=dados[0].Cod_Gato%>" />
                </div>
                <div>
                    <label for="">Nome</label>
                    <input type="text" disabled="" name="Nome_Gato" class="form-control" id="Nome_Gato" value="<%=dados[0].Nome_Gato%>" />
                </div>
                <div>
                    <label for="">Raça</label>
                    <input type="text" disabled="" name="raca" class="form-control" value="<%=dados[0].raca%>" />
                </div>
                <div>
                    <label for="">Idade</label>
                    <input type="number" disabled="" name="idade_Gato" class="form-control" value="<%=dados[0].idade_Gato%>" />
                </div>
                <br />
            <div>
                <input type="submit" value="Deletar" class="btn btn-sm btn-dark" />
                <a href="/Gatos" class="btn btn-outline-primary btn-sm">Voltar</a>
            </div>
        </form>
    </div>
</body>
</html>
