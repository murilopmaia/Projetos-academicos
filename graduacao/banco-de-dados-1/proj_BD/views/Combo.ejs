<%- include("head.ejs") -%>

<!DOCTYPE html>
<html lang="pt-br">
<head>
<title>CatCoffe</title>
</head>
<style>


    body {
            font-family: 'Roboto', sans-serif;
            background-color: antiquewhite;
        }
        .space {
            display: flex;
            align-items: center;
            flex-direction: column;
            gap: 2em;
            
        }
        .titulo {
            background-color: rgba(7, 7, 7, 0.781);
            width: 80%;
            padding-top: 3em;
            padding-bottom: 3em;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0em 0em 5em 5em;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            color: azure;
        }
        h1 {
            margin: 0;
            font-weight: 700;
        }
        table th, table td {
            padding: 1em;
            text-align: center;
        }
    
</style>
<body>
    <title>Café Felino</title>
</head>
<body class="container" style="background-color:azure">
<div class="space">


    <div class="titulo">
        <h1>Combos</h1>
    </div>
    <form action="" method="get" class="w-75">
        <div class="form-group">
            <label for="orderBy">Ordenar Por:</label>
            <select  name="orderby" id="orderby" class="form-control">
                    <option selected></option>
                    <option value="Cod_Combo">Código</option>
                    <option value="Bebida">Bebida</option>
                    <option value="Comida">Comida</option>
                    <option value="Disponibilidade">Disponibilidade</option>
                    <option value="Valor">Valor</option>
                    
            </select> 
        </div>
        
        <div class="form-group form-check">
            <input type="checkbox" class="form-check-input" id="groupBy" name="groupBy">
            <label class="form-check-label" for="groupBy">Agrupar por Disponibilidade</label>
        </div>
        
        <div class="form-group">
            <label for="having">Condição HAVING:</label>
            <input type="text" class="form-control" id="having" name="having">
        </div>
        
        <div class="form-group form-check">
            <input type="checkbox" class="form-check-input" id="rollup" name="rollup">
            <label class="form-check-label" for="rollup">Incluir ROLLUP</label>
        </div>

        <button type="submit" class="btn btn-primary">Consultar</button>
    </form>
    <%if(!aplicar) {%>
    <div >
        <table class="table table-striped" border="3">
            <thead class="thead-dark">
            <tr>
                <th scope="col">Código</th>
                <th scope="col">Bebida</th>
                <th scope="col">Comida</th>
                <th scope="col">Disponibilidade</th>
                <th scope="col">Valor</th>
                <th class="d-print-none">
                    <a class="btn btn-success" href="/inserirCo"><i class="fas fa-plus"></i> Cadastrar novo registro</a>
                </th>
                </tr>
            </thead>
            
            <tbody>
            <% for (var i=0; i < dados.length; i++) { %>
            <tr>
                <th><%= dados[i].Cod_Combo %></th>
                <td><%= dados[i].Bebida %></td>
                <td><%= dados[i].Comida %></td>
                
                <% if (dados[i].Disponibilidade == 1) { %>
                    <td>Disponível</td>
                <% } else { %>
                    <td>Indisponível</td>
                <% } %>
                
                <td>R$<%= dados[i].Valor %></td>
                <td class="d-print-none">
                    <a class="btn btn-warning" href="/editarCo/<%= dados[i].Cod_Combo%>"><i class="fas fa-edit"></i> Editar</a>
                    <a class="btn btn-danger" href="/deletarCo/<%= dados[i].Cod_Combo%>"><i class="fas fa-trash-alt"></i> Deletar</a>
                </td>
            </tr>
            <% } %>
            </tbody>
        </table>
    </div>
    <%} else {%>
        <table class="table table-striped" border="3">
            <thead class="thead-dark">
            <tr>
                <th scope="col">Disponibilidade</th>
                <th scope="col">Quantidade</th>
                <th scope="col">Valor Mínimo</th>
                <th scope="col">Valor Máximo</th>
                
                </tr>
            </thead>
            
            <tbody>
            <% for (var i=0; i < dados.length; i++) { %>
            <tr>
                <% if (dados[i].Disponibilidade == 1) { %>
                    <td>Disponível</td>
                <% } else if(dados[i].Disponibilidade != null){ %>
                    <td>Indisponível</td>
                <% } else {%>
                    <td><%=dados[i].Disponibilidade%></td>
                <%}%>
                <td><%= dados[i].quantidade %></td>
                <td><%= dados[i].valor_minimo %></td>
                <td><%= dados[i].valor_maximo  %></td>
            
            </tr>
            <% } %>
            </tbody>
        </table>
    <%}%>
</div>
</body>
</html>